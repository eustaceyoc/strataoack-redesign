# Bake the form host into the static build. Change it, then run npm run build again.
# php     cPanel / Apache (default)
# netlify Netlify Forms
# vercel  Vercel serverless function at /api/contact
VITE_FORM_PROVIDER=php

# Optional. Defaults are /api/contact.php, /, and /api/contact.
# VITE_FORM_ENDPOINT=
